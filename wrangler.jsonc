{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Cloudflare Worker's name. Your dashboard is at https://<name>.<your-subdomain>.workers.dev until you add a domain.
  "name": "open-analytics",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Your own domain (optional). Uncomment and set it; Cloudflare creates the DNS record and certificate:
  // "routes": [{ "pattern": "analytics.example.com", "custom_domain": true }],
  // Every 10 minutes: pull new Dodo payments for sites connected by API key (src/worker/dodo.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  // Per-IP limits, counted per Cloudflare location. EVENT_LIMIT guards the tracking endpoint;
  // API_LIMIT guards sign-in, the server API and uncached public reads.
  "ratelimits": [
    { "name": "EVENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Static files skip the Worker. Anything else (client routes, unknown paths) runs it so missing pages return a real 404.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-analytics",
      // Replace with the id printed by `npx wrangler d1 create open-analytics` (local development works without it).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
